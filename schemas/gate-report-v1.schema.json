{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gate-report-v1.schema.json",
  "title": "Simulation Evidence Gate Report v1",
  "description": "A threshold-source-aware report for simulation validation gates, evidence lineage, and claim boundaries. Version 1.1.0 is an additive profile; 1.0.0 instances remain valid.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "producer",
    "subject",
    "criteria_source",
    "gates",
    "overall",
    "claim_boundary",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0", "1.1.0"],
      "default": "1.1.0"
    },
    "report_id": {"$ref": "#/$defs/stableId"},
    "producer": {"$ref": "#/$defs/producer"},
    "subject": {"$ref": "#/$defs/subject"},
    "lineage": {"$ref": "#/$defs/reportLineage"},
    "criteria_source": {"$ref": "#/$defs/criteriaSource"},
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/gate"}
    },
    "overall": {"$ref": "common-status-v1.schema.json#/$defs/statusWithReasons"},
    "claim_boundary": {"$ref": "#/$defs/claimBoundary"},
    "limitations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true,
      "default": []
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill", "skill_version"],
      "properties": {
        "skill": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "skill_version": {"$ref": "#/$defs/semver"}
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "input_manifest_refs"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "id": {"$ref": "#/$defs/stableId"},
        "input_manifest_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "reportLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_id",
        "attempt_id",
        "stage",
        "snapshot_at",
        "subject_revision",
        "supersedes_report_id"
      ],
      "properties": {
        "workflow_id": {"$ref": "#/$defs/stableId"},
        "attempt_id": {"$ref": "#/$defs/stableId"},
        "stage": {"type": "string", "minLength": 1, "maxLength": 120},
        "snapshot_at": {"type": "string", "format": "date-time"},
        "subject_revision": {"type": "string", "minLength": 1, "maxLength": 120},
        "supersedes_report_id": {
          "oneOf": [
            {"$ref": "#/$defs/stableId"},
            {"type": "null"}
          ]
        }
      }
    },
    "criteriaSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "reference"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["user-defined", "project-specification", "reference-standard", "calibration", "other"]
        },
        "reference": {"type": "string", "minLength": 1},
        "version": {"type": ["string", "null"]},
        "notes": {"type": ["string", "null"]}
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "source_ref"],
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "operator": {
          "type": ["string", "null"],
          "enum": ["lt", "lte", "eq", "gte", "gt", "between", "set-membership", "boolean", "textual", null]
        },
        "threshold": {"type": ["number", "integer", "string", "boolean", "array", "null"]},
        "source_ref": {"type": "string", "minLength": 1}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "category",
        "required",
        "status",
        "reason_codes",
        "measured_value",
        "criterion",
        "units",
        "evidence_refs",
        "limitations"
      ],
      "properties": {
        "gate_id": {"$ref": "#/$defs/stableId"},
        "category": {"$ref": "#/$defs/gateCategory"},
        "required": {"type": "boolean"},
        "status": {"$ref": "common-status-v1.schema.json#/$defs/status"},
        "reason_codes": {"$ref": "common-status-v1.schema.json#/$defs/reasonCodes"},
        "measured_value": {"type": ["number", "integer", "string", "boolean", "array", "object", "null"]},
        "criterion": {"$ref": "#/$defs/criterion"},
        "units": {"type": ["string", "null"]},
        "evidence_refs": {
          "type": "array",
          "items": {
            "oneOf": [
              {"type": "string", "minLength": 1},
              {"$ref": "evidence-manifest-v1.schema.json"}
            ]
          },
          "uniqueItems": true
        },
        "limitations": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "PASS"}}, "required": ["status"]},
          "then": {
            "properties": {
              "reason_codes": {"maxItems": 0},
              "evidence_refs": {"minItems": 1}
            }
          },
          "else": {"properties": {"reason_codes": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"status": {"const": "FAIL"}}, "required": ["status"]},
          "then": {"properties": {"evidence_refs": {"minItems": 1}}}
        }
      ]
    },
    "gateCategory": {
      "type": "string",
      "minLength": 1,
      "description": "Open vocabulary. Foundation v0.2 registers evidence-integrity without restricting domain extensions.",
      "examples": [
        "input-identity",
        "solver-execution",
        "numerical-convergence",
        "conservation",
        "connectivity",
        "fair-comparison",
        "surrogate-high-fidelity-consistency",
        "evidence-integrity"
      ]
    },
    "claimObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "text", "status", "supporting_gate_ids", "limitations"],
      "properties": {
        "claim_id": {"$ref": "#/$defs/stableId"},
        "text": {"type": "string", "minLength": 1},
        "status": {
          "type": "string",
          "enum": ["supported", "conditional", "unsupported"]
        },
        "supporting_gate_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/stableId"},
          "uniqueItems": true
        },
        "limitations": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "claimBoundary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "supported": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "unsupported": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "conditional": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "claims": {
          "type": "array",
          "items": {"$ref": "#/$defs/claimObject"}
        }
      },
      "oneOf": [
        {
          "required": ["supported", "unsupported", "conditional"],
          "not": {"required": ["claims"]}
        },
        {
          "required": ["claims"],
          "not": {
            "anyOf": [
              {"required": ["supported"]},
              {"required": ["unsupported"]},
              {"required": ["conditional"]}
            ]
          }
        }
      ]
    }
  }
}
