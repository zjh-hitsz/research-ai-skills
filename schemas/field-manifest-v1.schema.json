{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "field-manifest-v1.schema.json",
  "title": "Physical Field Manifest v1",
  "description": "Identity, coordinate, regular-grid mapping, verification, output, and provenance contract for a physical field.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "field_id",
    "source_artifact_id",
    "source_hash",
    "source_tool",
    "field",
    "coordinates",
    "grid",
    "target_grid_ref",
    "mapping",
    "verification",
    "output",
    "provenance_ref",
    "status",
    "reason_codes",
    "limitations",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "field_id": {"$ref": "#/$defs/stableId"},
    "source_artifact_id": {"$ref": "#/$defs/stableId"},
    "source_hash": {"$ref": "#/$defs/sha256"},
    "source_tool": {"$ref": "#/$defs/sourceTool"},
    "field": {"$ref": "#/$defs/fieldIdentity"},
    "coordinates": {"$ref": "#/$defs/coordinates"},
    "grid": {"$ref": "#/$defs/grid"},
    "target_grid_ref": {"type": "string", "minLength": 1},
    "mapping": {"$ref": "#/$defs/mapping"},
    "verification": {"$ref": "#/$defs/verification"},
    "output": {"$ref": "#/$defs/output"},
    "provenance_ref": {"type": "string", "minLength": 1},
    "status": {"$ref": "common-status-v1.schema.json#/$defs/status"},
    "reason_codes": {"$ref": "common-status-v1.schema.json#/$defs/reasonCodes"},
    "limitations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "PASS"}}, "required": ["status"]},
      "then": {
        "properties": {
          "reason_codes": {"maxItems": 0},
          "output": {"properties": {"created": {"const": true}}}
        }
      },
      "else": {"properties": {"reason_codes": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/]).+"
    },
    "sourceTool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "export_method"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "export_method": {"type": "string", "minLength": 1}
      }
    },
    "fieldIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "physical_role", "components", "units", "sign_convention"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "physical_role": {"type": "string", "minLength": 1},
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "units": {"type": "string", "minLength": 1},
        "sign_convention": {"type": "string", "minLength": 1}
      }
    },
    "coordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "dimensions", "axis_order", "origin", "direction", "units"],
      "properties": {
        "system": {"type": "string", "minLength": 1},
        "dimensions": {"const": 2},
        "axis_order": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "origin": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "number"}
        },
        "direction": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "integer", "enum": [-1, 1]}
        },
        "units": {"type": "string", "minLength": 1}
      }
    },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "shape", "spacing", "domain", "cell_or_node_centered"],
      "properties": {
        "type": {"const": "regular_2d"},
        "shape": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "integer", "minimum": 1}
        },
        "spacing": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "number", "exclusiveMinimum": 0}
        },
        "domain": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximum"],
          "properties": {
            "minimum": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {"type": "number"}
            },
            "maximum": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {"type": "number"}
            }
          }
        },
        "cell_or_node_centered": {"type": "string", "enum": ["cell", "node"]}
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "parameters", "outside_domain_policy", "missing_value_policy"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "parameters": {"type": "object"},
        "outside_domain_policy": {"type": "string", "enum": ["reject", "fill", "clip", "extrapolate"]},
        "missing_value_policy": {"type": "string", "enum": ["reject", "fill", "ignore-with-coverage-penalty"]}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_integral", "target_integral", "relative_error", "coverage", "gate_report_ref"],
      "properties": {
        "source_integral": {"type": ["number", "null"]},
        "target_integral": {"type": ["number", "null"]},
        "relative_error": {"type": ["number", "null"], "minimum": 0},
        "coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "gate_report_ref": {"type": "string", "minLength": 1}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created", "path", "hash", "format"],
      "properties": {
        "created": {"type": "boolean"},
        "path": {"oneOf": [{"$ref": "#/$defs/relativePath"}, {"type": "null"}]},
        "hash": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "format": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"created": {"const": true}}, "required": ["created"]},
          "then": {
            "properties": {
              "path": {"$ref": "#/$defs/relativePath"},
              "hash": {"$ref": "#/$defs/sha256"}
            }
          },
          "else": {
            "properties": {
              "path": {"type": "null"},
              "hash": {"type": "null"}
            }
          }
        }
      ]
    }
  }
}
