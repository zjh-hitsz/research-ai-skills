{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-registry-v1.schema.json",
  "title": "Research AI Skill Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "repository_version", "skills"],
  "properties": {
    "registry_version": {"$ref": "#/$defs/semver"},
    "repository_version": {"$ref": "#/$defs/semver"},
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/skill"}
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "skillName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "boundedText": {"type": "string", "minLength": 1, "maxLength": 2000},
    "shortText": {"type": "string", "minLength": 1, "maxLength": 160},
    "stringSet": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/shortText"}
    },
    "examples": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "en": {"$ref": "#/$defs/stringSet"},
        "zh": {"$ref": "#/$defs/stringSet"}
      }
    },
    "triggerConcept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concept", "examples"],
      "properties": {
        "concept": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 80
        },
        "examples": {"$ref": "#/$defs/examples"}
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_tags",
        "domains",
        "trigger_concepts",
        "context_signals",
        "limitations",
        "execution_class"
      ],
      "properties": {
        "capability_tags": {"$ref": "#/$defs/stringSet"},
        "domains": {"$ref": "#/$defs/stringSet"},
        "trigger_concepts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {"$ref": "#/$defs/triggerConcept"}
        },
        "context_signals": {"$ref": "#/$defs/stringSet"},
        "limitations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {"$ref": "#/$defs/boundedText"}
        },
        "execution_class": {
          "type": "string",
          "enum": ["read-only", "deterministic-transform", "local-read-only-index"]
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "status",
        "dependencies",
        "description",
        "discovery"
      ],
      "properties": {
        "name": {"$ref": "#/$defs/skillName"},
        "version": {"$ref": "#/$defs/semver"},
        "status": {
          "type": "string",
          "enum": ["planned", "incubator", "implementation", "release-candidate", "released", "deprecated"]
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/skillName"}
        },
        "description": {"$ref": "#/$defs/boundedText"},
        "discovery": {"$ref": "#/$defs/discovery"}
      }
    }
  }
}
