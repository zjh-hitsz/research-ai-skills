{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/file-intelligence/maintenance-run.schema.json",
  "title": "File Intelligence maintenance result",
  "type": "object",
  "required": ["schema_version", "run_id", "mode", "status", "counts", "physical_actions"],
  "properties": {
    "schema_version": {"const": 3},
    "run_id": {"type": "string"},
    "mode": {"enum": ["MAINTENANCE", "WEEKLY_DEEP_MAINTENANCE"]},
    "status": {"enum": ["NO_OP", "CHANGES_RECORDED"]},
    "counts": {"type": "object"},
    "filesystem_changes": {"type": "integer", "minimum": 0},
    "volatile_changes": {"type": "integer", "minimum": 0},
    "meaningful_changes": {"type": "integer", "minimum": 0},
    "semantic_status": {"enum": ["NO_MEANINGFUL_CHANGE", "MEANINGFUL_CHANGE"]},
    "identity_events": {"type": "object"},
    "events_recorded": {"type": "integer", "minimum": 0},
    "semantic_summary": {"type": "object"},
    "snapshot": {"type": "object"},
    "physical_actions": {"const": 0}
  },
  "additionalProperties": true
}
