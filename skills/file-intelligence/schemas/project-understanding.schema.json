{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/file-intelligence/project-understanding.schema.json",
  "title": "File Intelligence private project-understanding result",
  "type": "object",
  "required": ["schema_version", "project", "workstreams", "authorities", "dependencies", "physical_actions"],
  "properties": {
    "schema_version": {"const": 2},
    "project": {
      "type": "object",
      "required": ["project_id", "name", "root_path", "purpose", "lifecycle", "confidence", "evidence"],
      "properties": {
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      },
      "additionalProperties": true
    },
    "workstreams": {"type": "array", "items": {"type": "object"}},
    "authorities": {"type": "array", "items": {"type": "object"}},
    "dependencies": {"type": "object"},
    "physical_actions": {"const": 0}
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["type", "detail"],
      "properties": {
        "type": {
          "enum": ["explicit_user", "explicit_project_metadata", "git_evidence", "document_evidence", "structural_inference", "temporal_inference", "content_similarity", "model_inference"]
        },
        "detail": {"type": "string"},
        "source_path": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
